# Bot token from https://discord.com/developers/applications (Bot tab).
# Enable "Message Content Intent" there too.
DISCORD_TOKEN=

# Any OpenAI-compatible API: OpenAI, OpenRouter, Groq, Ollama (http://localhost:11434/v1), etc.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are Nova, a helpful Discord assistant. Keep answers concise.

# Optional: channel IDs (comma-separated) where bot answers every message without a mention.
AI_CHANNELS=
# Messages remembered per channel.
HISTORY_LIMIT=20
# SQLite database path for persistent chat history, or :memory: for ephemeral.
MEMORY_PATH=data/nova.db
# Minimum seconds between answers for the same user (0 disables).
USER_COOLDOWN_SEC=3

# Status API (Elysia): GET /health, GET /stats. Use HOST=0.0.0.0 inside Docker.
HOST=127.0.0.1
PORT=3000
